        {
          "id": "83cf2d77-7f84-448e-b23d-7d02527dca33",
          "name": "Get repository indexing status",
          "request": {
            "name": "Get repository indexing status",
            "description": {
              "content": "Returns metadata and indexing progress for a previously submitted repository. The repositoryId is the URL-encoded composite identifier in the form remote:branch:owner/repository (for example github%3Amain%3Agreptileai%2Fgreptile).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repositories",
                ":repositoryId"
