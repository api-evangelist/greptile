      "id": "c1238f7e-928c-4ca6-957b-b5b820cc69d6",
      "name": "Repositories",
      "description": {
        "content": "Submit repositories for indexing and check indexing status.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3410df82-89fb-465e-bf8e-168f3aca0a20",
          "name": "Submit a repository for indexing",
          "request": {
            "name": "Submit a repository for indexing",
            "description": {
              "content": "Queues a Git repository (identified by remote, repository, and branch) for processing into Greptile's graph and embeddings. Indexing is asynchronous; poll GET /repositories/{repositoryId} until a sha is present, which indicates the repository is ready to be queried.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repositories"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remote\": \"<string>\",\n  \"repository\": \"<string>\",\n  \"branch\": \"<string>\",\n  \"reload\": false,\n  \"notify\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "96538281-4f55-4987-ab65-10ec46d244c1",
              "name": "Repository accepted for indexing.",
              "originalRequest": {
                "url": {
