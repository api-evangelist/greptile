      },
      "item": [
        {
          "id": "9ac91d6b-e16b-42dc-b09e-e2de0fe44531",
          "name": "Query repositories in natural language",
          "request": {
            "name": "Query repositories in natural language",
            "description": {
              "content": "Submits a natural-language question against one or more indexed repositories and returns a synthesized answer plus the source files, functions, and classes used to construct it. Set stream to true to receive the answer incrementally as Server-Sent Events. Set genius to true to use a larger, more accurate model better suited to complex bug diagnosis (billed at a higher per-query rate).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string>\",\n      \"id\": \"<string>\"\n    },\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string>\",\n      \"id\": \"<string>\"\n    }\n  ],\n  \"repositories\": [\n    {\n      \"remote\": \"<string>\",\n      \"repository\": \"<string>\",\n      \"branch\": \"<string>\"\n    },\n    {\n      \"remote\": \"<string>\",\n      \"repository\": \"<string>\",\n      \"branch\": \"<string>\"\n    }\n  ],\n  \"sessionId\": \"<string>\",\n  \"stream\": false,\n  \"genius\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
