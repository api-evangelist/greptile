                  "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"How is authentication handled in this codebase?\",\n      \"id\": \"<string>\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"How is authentication handled in this codebase?\",\n      \"id\": \"<string>\"\n    }\n  ],\n  \"repositories\": [\n    {\n      \"remote\": \"github\",\n      \"repository\": \"greptileai/greptile\",\n      \"branch\": \"main\"\n    },\n    {\n      \"remote\": \"github\",\n      \"repository\": \"greptileai/greptile\",\n      \"branch\": \"main\"\n    }\n  ],\n  \"sessionId\": \"session-abc-123\",\n  \"stream\": false,\n  \"genius\": false\n}",
